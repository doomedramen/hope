# Copy to .env and fill in real values. Never commit .env.
# Consumed by deploy/compose/docker-compose.yml.

POSTGRES_USER=hope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hope

# Server reads HOPE_-prefixed env vars (see apps/server/src/config.rs).
HOPE_DATABASE_URL=postgres://hope:change-me@postgres:5432/hope
HOPE_BIND_ADDR=0.0.0.0:8080

# This compose file serves plain HTTP with no fronting TLS proxy (see
# docs/threat-model.md gap: "main API listener has no TLS of its own").
# The session cookie defaults to Secure=true, which browsers silently
# drop over plain HTTP -- set this to false for this docker-compose
# quickstart / local dev, and leave it at the default (true, i.e. don't
# set this var) once you put a real TLS-terminating proxy in front.
HOPE_COOKIE_SECURE=false
