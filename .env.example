# Copy to .env. Never commit .env.
# Paths ending in _HOST are resolved relative to deploy/compose/docker-compose.yml.

POSTGRES_USER=hope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hope
HOPE_DATABASE_URL=postgres://hope:change-me@postgres:5432/hope

# Published server/worker image. Pin HOPE_IMAGE to an immutable digest for
# production. Use deploy/compose/docker-compose.local-build.yml for a source build.
HOPE_IMAGE=ghcr.io/doomedramen/hope:main

# API listener. Compose publishes this to localhost by default.
HOPE_BIND_ADDR=0.0.0.0:8080

# Local quickstart uses plain HTTP, so the browser can retain its session
# cookie. Set true for any deployment behind a TLS reverse proxy.
HOPE_COOKIE_SECURE=false
HOPE_TRUST_PROXY_HEADERS=false

# Compose host paths. Keep the credential key outside .env when possible, and
# never put the key value in this file.
HOPE_CREDENTIAL_MASTER_KEY_HOST=./secrets/credential-master-key
HOPE_AGENT_RELEASE_DIR_HOST=./agent-releases

# Optional host publish overrides. Defaults keep HTTP on localhost and expose
# the two server-terminated TLS listeners for enrolled agents.
# HOPE_HTTP_BIND=127.0.0.1
# HOPE_HTTP_PORT=8080
# HOPE_GATEWAY_BIND=0.0.0.0
# HOPE_GATEWAY_PORT=8443
# HOPE_ENROLL_BIND=0.0.0.0
# HOPE_ENROLL_PORT=8444

# The Compose service mounts the key at this container path.
HOPE_CREDENTIAL_MASTER_KEY_FILE=/run/secrets/hope_credential_master_key

# Agent URLs are required by server and worker configuration. Replace these
# local values for a real deployment. Agent gateway and enrollment use the
# server's TLS listeners, not the plain HTTP API listener.
HOPE_AGENT_ENROLL_URL=https://localhost:8444
HOPE_AGENT_GATEWAY_URL=wss://localhost:8443

# Read-only release repository and platform-specific verified artifacts.
HOPE_AGENT_BINARY_X86_64=/app/agent-releases/agent-linux-amd64
HOPE_AGENT_BINARY_AARCH64=/app/agent-releases/agent-linux-arm64
HOPE_RELEASE_PUBLIC_KEY_FILE=/app/agent-releases/public-key.hex
# During key rotation, set one or more comma/space/newline-separated public
# keys here. Keep the old key until every supported agent trusts the new key.
# HOPE_RELEASE_PUBLIC_KEYS=<old-public-key>,<new-public-key>

# Retention defaults. These values are copied into daily worker job payloads.
HOPE_CHANGE_EVENT_RETENTION_DAYS=365
HOPE_MONITOR_RESULT_RETENTION_DAYS=90
HOPE_MONITOR_RESULT_ROLLUP_AFTER_DAYS=7
HOPE_MONITOR_RESULT_ROLLUP_RETENTION_DAYS=365
HOPE_AUDIT_EVENT_RETENTION_DAYS=365
HOPE_JOB_RETENTION_DAYS=30

# M9 maintenance defaults. Horizon accepts 1..366 days. The global disruptive
# lock is enabled by default and should be disabled only with a reviewed plan.
HOPE_MAINTENANCE_HORIZON_DAYS=90
HOPE_MAINTENANCE_GLOBAL_DISRUPTIVE_LOCK=true
