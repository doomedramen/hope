HOPE_SERVER_URL=https://hope.example.com
# Bind to an address reachable by your existing reverse proxy.
HOPE_BIND=127.0.0.1:8080
# Set to the CA path expected on agent hosts when using a private CA; otherwise leave empty.
HOPE_AGENT_CA=
# Reverse proxies (addresses or CIDRs) whose X-Forwarded-For header is believed when rate-limiting
# failed logins and enrollments per client. Leave empty for the default: when HOPE_BIND is
# loopback-only (127.0.0.1 / ::1, the same-host proxy setup above) loopback is trusted
# automatically, because only local processes can reach that listener. For any other bind (for
# example the Docker Desktop file, which binds 0.0.0.0 in the container) nothing is trusted until
# you list the proxy's address as the server sees it, otherwise all clients share one budget.
HOPE_TRUSTED_PROXIES=
