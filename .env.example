# Copy to .env and fill in real values. Never commit .env.
# Consumed by deploy/compose/docker-compose.yml.

POSTGRES_USER=hope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hope

# Server reads HOPE_-prefixed env vars (see apps/server/src/config.rs).
HOPE_DATABASE_URL=postgres://hope:change-me@postgres:5432/hope
HOPE_BIND_ADDR=0.0.0.0:8080
