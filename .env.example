# Optional Compose overrides. The default stack works without this file.

HOPE_IMAGE=ghcr.io/doomedramen/hope:main

POSTGRES_USER=hope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hope
HOPE_DATABASE_URL=postgres://hope:change-me@postgres:5432/hope

# Local HTTP is intentionally plain so the browser can keep its session cookie.
# Set true when HTTP is behind a TLS reverse proxy.
HOPE_COOKIE_SECURE=false

# Publish HTTP locally or to the homelab network.
# HOPE_HTTP_BIND=127.0.0.1
# HOPE_HTTP_PORT=8080
# HOPE_GATEWAY_BIND=0.0.0.0
# HOPE_GATEWAY_PORT=8443
# HOPE_ENROLL_BIND=0.0.0.0
# HOPE_ENROLL_PORT=8444

# The defaults assume agents can reach the host at localhost. Replace these
# with the server hostname for a real agent deployment.
HOPE_AGENT_ENROLL_URL=https://localhost:8444
HOPE_AGENT_GATEWAY_URL=wss://localhost:8443

# Optional host directory containing verified agent releases.
HOPE_AGENT_RELEASE_DIR_HOST=./agent-releases
